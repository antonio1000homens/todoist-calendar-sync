{
  "name": "todoist-calendar-sync",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:review": "mkdir -p cloudflare/calendar-sync/public/review && cp review-ui/index.html cloudflare/calendar-sync/public/review/index.html && cp review-ui/review.css cloudflare/calendar-sync/public/review/review.css && esbuild review-ui/main.tsx --bundle --minify --format=esm --target=es2022 --outfile=cloudflare/calendar-sync/public/review/review.js",
    "test": "npm run build && node --import ./test/setup-env.mjs --test test/*.test.mjs",
    "e2e:production": "npm run build --silent && node scripts/production-e2e.mjs",
    "e2e:production-erasure": "npm run build --silent && node scripts/production-erasure-e2e.mjs",
    "recur:phase-b:sandbox": "npm run build --silent && node scripts/phase-b-sandbox-capture.mjs",
    "migrate:project-comments": "npm run build --silent && node scripts/project-comment-migration.mjs",
    "migrate:profile-lookup-index": "npm run build --silent && node scripts/backfill-profile-lookup-index.mjs",
    "seed:review-inbox": "npm run build --silent && node scripts/seed-review-inbox.mjs",
    "cleanup:routine-audit": "npm run build --silent && node scripts/cleanup-routine-audit.mjs",
    "state:inspect": "npm run build --silent && node scripts/audit-state-retention.mjs",
    "state:inspect-verified-deletion-residue": "node scripts/inspect-verified-deletion-residue.mjs",
    "state:inspect-repair-retention": "npm run build --silent && node scripts/inspect-repair-retention.mjs",
    "state:audit-deleted-recurrences": "npm run build --silent && node scripts/audit-deleted-recurrences.mjs",
    "state:cleanup-completed": "npm run build --silent && node scripts/cleanup-terminal-completions.mjs",
    "state:cleanup-completed-comment": "npm run build --silent && node scripts/cleanup-completed-project-comment.mjs",
    "cleanup:erasure-tombstones": "npm run build --silent && node scripts/cleanup-erasure-tombstones.mjs",
    "audit:erasure:codedeploy": "node scripts/audit-erasure-lambda-codedeploy.mjs",
    "purge:item": "npm run build --silent && node scripts/purge-item.mjs",
    "check:public": "bash scripts/check-public-source.sh",
    "check:capacity": "node scripts/check-dynamodb-capacity.mjs",
    "cost:audit": "node scripts/monthly-cost-audit.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-codedeploy": "^3.1163.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-lambda": "^3.1163.0",
    "@aws-sdk/client-sqs": "^3.1163.0",
    "@aws-sdk/client-ssm": "^3.1161.0",
    "@aws-sdk/credential-provider-ini": "^3.973.25",
    "@aws-sdk/lib-dynamodb": "^3.1163.0",
    "jose": "^6.2.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
